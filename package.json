{
  "name": "github-actions",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A minimal React + Electron application",
  "author": "Antigravity",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.example.react-electron",
    "artifactName": "${name}-${version}-setup.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mugilan-a-git",
        "repo": "github_actions_demo"
      }
    ],
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
